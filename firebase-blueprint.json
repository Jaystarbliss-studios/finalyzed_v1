{
  "entities": {
    "User": {
      "title": "User Profile",
      "description": "User profile containing name, email, role",
      "type": "object",
      "properties": {
        "name": { "type": "string", "maxLength": 100 },
        "email": { "type": "string", "maxLength": 200 },
        "role": { "type": "string", "enum": ["student", "specialist", "editor", "admin"] },
        "createdAt": { "type": "timestamp" }
      },
      "required": ["name", "email", "role", "createdAt"]
    },
    "Project": {
      "title": "Project",
      "description": "A commissioned academic project",
      "type": "object",
      "properties": {
        "studentId": { "type": "string", "maxLength": 128 },
        "specialistId": { "type": "string", "maxLength": 128 },
        "editorId": { "type": "string", "maxLength": 128 },
        "status": { "type": "string", "maxLength": 50 },
        "title": { "type": "string", "maxLength": 200 },
        "createdAt": { "type": "timestamp" }
      }
    }
  },
  "firestore": {
    "/users/{userId}": {
      "schema": { "$ref": "#/entities/User" },
      "description": "User profiles"
    },
    "/projects/{projectId}": {
      "schema": { "$ref": "#/entities/Project" },
      "description": "Projects"
    }
  }
}
